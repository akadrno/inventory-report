# Copy this file to .env.local and fill in your values
# Never commit .env.local — it is excluded by .gitignore

# Azure AD App Registration Client ID
# Create your app registration at:
# https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
VITE_CLIENT_ID=your-app-registration-client-id-here

# Your Azure AD Tenant ID or primary domain
# Example: 00000000-0000-0000-0000-000000000000  or  contoso.onmicrosoft.com
VITE_TENANT_ID=your-tenant-id-or-domain-here
