# UNSUPPORTED SAMPLE CODE - NOT SUPPORTED BY MICROSOFT
# Review SUPPORT.md before use.
# Copy this file to .env.local and fill in the two required values.
# Never commit .env.local — it is excluded by .gitignore

# REQUIRED: Microsoft Entra App Registration Client ID
# Create your app registration at:
# https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
VITE_CLIENT_ID=your-app-registration-client-id-here

# REQUIRED: Microsoft Entra Tenant ID or primary domain
# Example: 00000000-0000-0000-0000-000000000000  or  contoso.onmicrosoft.com
VITE_TENANT_ID=your-tenant-id-or-domain-here

# OPTIONAL: Azure Storage account name for shared assessments, tags, and sign-in cache
# If omitted, data is stored in browser localStorage only
VITE_STORAGE_ACCOUNT=your-storage-account-name-here

# OPTIONAL: Account-level SAS token for Azure Table Storage
# This value is embedded in the client bundle and visible to app users. Use a narrow scope and expiry.
# Required permissions: Read, Add, Create, Update, Delete, List on Table service (Object + Container resource types)
# Generate in Azure portal: Storage account → Shared access signature
# Or via CLI: az storage account generate-sas --services t --resource-types co --permissions racudl ...
VITE_TABLE_SAS=your-account-level-sas-token-here
